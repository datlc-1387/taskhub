APP_NAME="TaskHub API"
DEBUG=true

# localhost = app running on your machine; docker compose overrides it to host `db` for the app container
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CACHE_TTL_SECONDS=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Postgres in docker-compose.yml
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub
POSTGRES_DB=taskhub

# Redis
REDIS_HOST=localhost # overridden to `redis` in docker compose
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# Mailpit
MAIL_ENABLED=true
SMTP_HOST=localhost # overridden to `mailpit` in docker compose
SMTP_PORT=1025
SMTP_FROM=noreply@taskhub.local
SMTP_STARTTLS=false
MAILPIT_UI_AUTH=taskhub:change-me-mailpit-password
