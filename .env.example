# Copy thành .env rồi sửa. Mọi biến đều có default trong app/core/config.py.
APP_NAME="TaskHub API"
DEBUG=true

DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub

# Postgres trong docker-compose.yml (phải khớp với DATABASE_URL)
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub
POSTGRES_DB=taskhub
